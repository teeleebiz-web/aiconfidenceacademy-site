# Names only. Keep all actual values outside this public repository.
# Existing production entry point; not a source of backed-up credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACA_PHASE_ONE_COURSE_ID=
ACA_PHASE_TWO_COURSE_ID=
ACA_PHASE_TWO_COHORT_ID=
ACA_PHASE_TWO_PAID_IN_FULL_PRICE_ID=
ACA_PHASE_TWO_STANDARD_PRICE_ID=
ACA_PHASE_TWO_INSTALLMENT_67_PRICE_ID=
ACA_PHASE_TWO_INSTALLMENT_66_PRICE_ID=
ACA_CONSTRUCTION_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ACA_PHASE_ONE_PRICE_ID=
ACA_PHASE_ONE_FOUNDING_PRICE_ID=
ACA_INSTALLMENT_50_PRICE_ID=
ACA_INSTALLMENT_49_PRICE_ID=
RESEND_API_KEY=
ACA_NEWSLETTER_RESEND_KEY=
RESEND_WEBHOOK_SECRET=
ACA_EMAIL_FROM=
ACA_APP_URL=
CRON_SECRET=
# Recovery utility only; file contains 32 random bytes. Never commit the file.
ACA_BACKUP_KEY_FILE=
# Approved private R2 destination. Values go only in a private execution context.
ACA_R2_ACCOUNT_ID=
ACA_R2_BUCKET=
ACA_R2_ACCESS_KEY_ID=
ACA_R2_SECRET_ACCESS_KEY=
ACA_R2_JURISDICTION=default
# Set to the exact account-id/bucket only after checking private settings.
ACA_R2_PRIVATE_CONFIRMED=
# Per-transfer guard only; this is not an account billing cap.
ACA_R2_MAX_SNAPSHOT_BYTES=2147483648
# Manual GitHub backup only. Never put values in this public template.
ACA_BACKUP_KEY_BASE64=
ACA_BACKUP_SOURCE_SERVICE_ROLE_KEY=
ACA_BACKUP_OWNER_KEY_SAVED=false
ACA_BACKUP_SOURCE_ACCESS_CONFIRMED=false

# External availability: non-secret configuration JSON, not a live-status claim.
# Retain monitor IDs/contact group/provider settings separately; never put a token here.
ACA_EXTERNAL_AVAILABILITY=
# GitHub private incident collector only; stored as a repository secret.
ACA_STATUSCAKE_TOKEN=
# Cloudflare Worker only; dedicated diagnostic-workflow token, not a backup token.
ACA_TIMER_GITHUB_TOKEN=
ACA_TIMER_ENABLED=false
# Optional frontend build overrides for a reviewed isolated target. Never put a
# service-role key in VITE_*; blank placeholders are NOT a usable dotenv file.
# Defaults in source point to production. Overrides alone do not prove isolation.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ACA_BACKEND_ORIGIN=
# Optional bookstore integration; not observed in current production env metadata.
# Keep sales off unless separately authorized; do not infer a missing webhook key.
ACA_BOOKSTORE_SALES_ENABLED=false
ACA_BOOKSTORE_WEBHOOK_SECRET=
# Workflow identity, retry deadline and incident mode are injected by the reviewed
# workflows, not secrets to recover. Do not execute those workflows on a clone.
