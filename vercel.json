{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "mkdir -p vercel-public",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/site.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "/api/site.mjs?__aca_path=$1"
    }
  ]
}
