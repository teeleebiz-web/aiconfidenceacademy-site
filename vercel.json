{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:academy",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/site.mjs": {
      "includeFiles": "private-dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/:path*", "destination": "/api/site?__aca_path=:path*" }]
}
