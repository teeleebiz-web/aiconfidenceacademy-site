{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:site",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/site.mjs": {
      "includeFiles": "private-dist/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/enrollment/installment-maintenance",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/email/lesson-release-maintenance",
      "schedule": "0 16 * * *"
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/api/site.mjs?__aca_path=index.html" },
    { "src": "^/(.*)$", "dest": "/api/site.mjs?__aca_path=$1" }
  ]
}
