{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:academy",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/site.mjs": {
      "includeFiles": "private-dist/**",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/site.mjs?__aca_path=index.html" },
    { "src": "^/(.*)$", "dest": "/api/site.mjs?__aca_path=$1" }
  ]
}
